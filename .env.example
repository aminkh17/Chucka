# Copy this file to .env and fill in your own values. NEVER commit .env.

# --- Required ---------------------------------------------------------------

# The Obsidian vault to read (absolute path).
VAULT=/Users/you/Obsidian/YourVault

# Destination phone number in international format, digits only.
# Your own number = a personal morning briefing to yourself.
WA_TO=61400000000

# OpenWA session name (the session you linked by scanning the QR code once).
OPENWA_SESSION=default

# Binaries — absolute paths recommended: launchd jobs run with a minimal PATH.
PYTHON_BIN=/usr/bin/python3
OPENWA_NODE=/usr/local/bin/node

# --- Optional ---------------------------------------------------------------

# opencode CLI (script generation). Any model the CLI can reach works.
# OPENCODE_BIN=/opt/homebrew/bin/opencode
# PODCAST_MODEL=opencode/deepseek-v4.1-flash-free

# OpenWA gateway location (defaults match a checkout in OpenWA/ next to the sources).
# OPENWA_URL=http://localhost:2785
# OPENWA_KEY_FILE=OpenWA/data/.api-key

# Gemini TTS fallback voice. Without a key the fallback chain ends at macOS `say`.
# Get one at https://aistudio.google.com
GEMINI_API_KEY=

# Voice knobs (defaults shown; all optional).
# PODCAST_VS_VOICE=Farah        # VoiceStudio profile name or id
# PODCAST_VS_SPEED=1.08         # speaking pace for VoiceStudio
# PODCAST_VS_INSTRUCT=          # optional voice-design style, e.g. "young adult, high pitch"
# PODCAST_GEMINI_VOICE=Kore     # Gemini prebuilt voice
# PODCAST_VOICE=Samantha        # macOS say voice (last-resort fallback)
# PODCAST_RATE=175              # macOS say words per minute
